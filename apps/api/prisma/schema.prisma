generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum RoleEnum {
  ADMIN
  OPERATIONS
  FINANCE
  RISK_ANALYST
  CUSTOMER_SUPPORT
  CUSTOMER
  AUDITOR
}

enum PaymentStatusEnum {
  INITIATED
  AUTHORIZED
  PROCESSING
  COMPLETED
  FAILED
  CANCELLED
  REFUNDED
  PARTIALLY_REFUNDED
  CHARGEBACK
}

enum PaymentMethodEnum {
  CARD
  BANK_TRANSFER
  UPI
  WALLET
  ACH
  SEPA
  WIRE
}

enum PaymentProviderEnum {
  STRIPE
  ADYEN
  MOCK_BANK_RAIL
  SWIFT
  SEPA_CORE
}

enum AccountTypeEnum {
  CHECKING
  SAVINGS
  BUSINESS
  MERCHANT
  WALLET
}

enum AccountStatusEnum {
  ACTIVE
  FROZEN
  SUSPENDED
  CLOSED
}

enum CurrencyEnum {
  USD
  EUR
  GBP
  INR
  JPY
  CAD
  AUD
  SGD
}

enum TransactionTypeEnum {
  DEBIT
  CREDIT
  TRANSFER
  PAYMENT
  REFUND
  FEE
  CHARGEBACK
  ADJUSTMENT
}

enum TransactionDirectionEnum {
  INBOUND
  OUTBOUND
  INTERNAL
}

enum TransactionStatusEnum {
  PENDING
  POSTED
  SETTLED
  FAILED
  REVERSED
}

enum LedgerEntryTypeEnum {
  DEBIT
  CREDIT
}

enum KycStatusEnum {
  PENDING
  VERIFIED
  REJECTED
  EXPIRED
}

enum RiskLevelEnum {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum FraudAlertStatusEnum {
  OPEN
  INVESTIGATING
  CONFIRMED
  FALSE_POSITIVE
  RESOLVED
}

enum NotificationTypeEnum {
  PAYMENT_SUCCESS
  PAYMENT_FAILED
  FRAUD_ALERT
  ACCOUNT_ALERT
  SECURITY_ALERT
  SYSTEM_ALERT
}

model User {
  id             String      @id @default(uuid())
  externalAuthId String      @unique @map("external_auth_id")
  email          String      @unique
  firstName      String      @map("first_name")
  lastName       String      @map("last_name")
  phone          String?
  status         String      @default("ACTIVE")
  lastLoginAt    DateTime?   @map("last_login_at")
  createdAt      DateTime    @default(now()) @map("created_at")
  updatedAt      DateTime    @updatedAt @map("updated_at")
  roles          UserRole[]
  auditLogs      AuditLog[]

  @@map("users")
}

model UserRole {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  role      RoleEnum
  createdAt DateTime @default(now()) @map("created_at")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, role])
  @@map("user_roles")
}

model Customer {
  id             String         @id @default(uuid())
  customerNumber String         @unique @map("customer_number")
  firstName      String         @map("first_name")
  lastName       String         @map("last_name")
  email          String         @unique
  phone          String
  country        String
  kycStatus      KycStatusEnum  @default(PENDING) @map("kyc_status")
  riskLevel      RiskLevelEnum  @default(LOW) @map("risk_level")
  riskScore      Int            @default(15) @map("risk_score")
  status         String         @default("ACTIVE")
  createdAt      DateTime       @default(now()) @map("created_at")
  updatedAt      DateTime       @updatedAt @map("updated_at")
  accounts       Account[]
  payments       Payment[]
  fraudAlerts    FraudAlert[]

  @@index([customerNumber])
  @@index([email])
  @@index([riskLevel])
  @@map("customers")
}

model Account {
  id               String            @id @default(uuid())
  accountNumber    String            @unique @map("account_number")
  customerId       String            @map("customer_id")
  accountType      AccountTypeEnum   @map("account_type")
  currency         CurrencyEnum      @default(USD)
  availableBalance Decimal           @default(0.0000) @map("available_balance") @db.Decimal(19, 4)
  ledgerBalance    Decimal           @default(0.0000) @map("ledger_balance") @db.Decimal(19, 4)
  status           AccountStatusEnum @default(ACTIVE)
  version          Int               @default(1)
  createdAt        DateTime          @default(now()) @map("created_at")
  updatedAt        DateTime          @updatedAt @map("updated_at")

  customer         Customer          @relation(fields: [customerId], references: [id], onDelete: Cascade)
  sourcePayments   Payment[]         @relation("SourceAccount")
  destPayments     Payment[]         @relation("DestinationAccount")
  transactions     Transaction[]
  ledgerEntries    LedgerEntry[]

  @@index([accountNumber])
  @@index([customerId])
  @@map("accounts")
}

model Payment {
  id                   String              @id @default(uuid())
  paymentReference     String              @unique @map("payment_reference")
  idempotencyKey       String              @unique @map("idempotency_key")
  customerId           String              @map("customer_id")
  sourceAccountId      String              @map("source_account_id")
  destinationAccountId String              @map("destination_account_id")
  amount               Decimal             @db.Decimal(19, 4)
  currency             CurrencyEnum
  paymentMethod        PaymentMethodEnum   @map("payment_method")
  status               PaymentStatusEnum   @default(INITIATED)
  provider             PaymentProviderEnum @default(MOCK_BANK_RAIL)
  providerReference    String?             @map("provider_reference")
  riskScore            Int                 @default(0) @map("risk_score")
  failureReason        String?             @map("failure_reason")
  metadata             Json?
  createdAt            DateTime            @default(now()) @map("created_at")
  updatedAt            DateTime            @updatedAt @map("updated_at")

  customer             Customer            @relation(fields: [customerId], references: [id])
  sourceAccount        Account             @relation("SourceAccount", fields: [sourceAccountId], references: [id])
  destinationAccount   Account             @relation("DestinationAccount", fields: [destinationAccountId], references: [id])
  events               PaymentEvent[]
  transactions         Transaction[]
  fraudAlerts          FraudAlert[]

  @@index([paymentReference])
  @@index([idempotencyKey])
  @@index([customerId])
  @@index([status])
  @@index([createdAt])
  @@map("payments")
}

model PaymentEvent {
  id         String            @id @default(uuid())
  paymentId  String            @map("payment_id")
  fromStatus PaymentStatusEnum @map("from_status")
  toStatus   PaymentStatusEnum @map("to_status")
  reason     String?
  createdAt  DateTime          @default(now()) @map("created_at")

  payment    Payment           @relation(fields: [paymentId], references: [id], onDelete: Cascade)

  @@index([paymentId])
  @@map("payment_events")
}

model Transaction {
  id                   String                   @id @default(uuid())
  transactionReference String                   @unique @map("transaction_reference")
  paymentId            String?                  @map("payment_id")
  accountId            String                   @map("account_id")
  type                 TransactionTypeEnum
  amount               Decimal                  @db.Decimal(19, 4)
  currency             CurrencyEnum
  direction            TransactionDirectionEnum
  status               TransactionStatusEnum    @default(POSTED)
  balanceBefore        Decimal                  @map("balance_before") @db.Decimal(19, 4)
  balanceAfter         Decimal                  @map("balance_after") @db.Decimal(19, 4)
  description          String
  metadata             Json?
  createdAt            DateTime                 @default(now()) @map("created_at")

  payment              Payment?                 @relation(fields: [paymentId], references: [id])
  account              Account                  @relation(fields: [accountId], references: [id])
  ledgerEntries        LedgerEntry[]

  @@index([transactionReference])
  @@index([accountId])
  @@index([paymentId])
  @@index([status])
  @@index([createdAt])
  @@map("transactions")
}

model LedgerEntry {
  id            String              @id @default(uuid())
  transactionId String              @map("transaction_id")
  accountId     String              @map("account_id")
  entryType     LedgerEntryTypeEnum @map("entry_type")
  amount        Decimal             @db.Decimal(19, 4)
  currency      CurrencyEnum
  postedAt      DateTime            @default(now()) @map("posted_at")

  transaction   Transaction         @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  account       Account             @relation(fields: [accountId], references: [id])

  @@index([transactionId])
  @@index([accountId])
  @@index([postedAt])
  @@map("ledger_entries")
}

model FraudRule {
  id          String   @id @default(uuid())
  ruleCode    String   @unique @map("rule_code")
  name        String
  description String
  criteria    Json
  scoreWeight Int      @default(20) @map("score_weight")
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")

  alerts      FraudAlert[]

  @@map("fraud_rules")
}

model FraudAlert {
  id             String               @id @default(uuid())
  alertReference String               @unique @map("alert_reference")
  paymentId      String               @map("payment_id")
  customerId     String               @map("customer_id")
  ruleId         String?              @map("rule_id")
  riskScore      Int                  @map("risk_score")
  riskLevel      RiskLevelEnum        @map("risk_level")
  status         FraudAlertStatusEnum @default(OPEN)
  triggers       Json
  createdAt      DateTime             @default(now()) @map("created_at")
  updatedAt      DateTime             @updatedAt @map("updated_at")

  payment        Payment              @relation(fields: [paymentId], references: [id])
  customer       Customer             @relation(fields: [customerId], references: [id])
  rule           FraudRule?           @relation(fields: [ruleId], references: [id])
  investigations FraudInvestigation[]

  @@index([alertReference])
  @@index([paymentId])
  @@index([customerId])
  @@index([status])
  @@index([riskLevel])
  @@map("fraud_alerts")
}

model FraudInvestigation {
  id          String               @id @default(uuid())
  alertId     String               @map("alert_id")
  analystId   String               @map("analyst_id")
  analystName String               @map("analyst_name")
  notes       String
  decision    FraudAlertStatusEnum
  createdAt   DateTime             @default(now()) @map("created_at")

  alert       FraudAlert           @relation(fields: [alertId], references: [id], onDelete: Cascade)

  @@index([alertId])
  @@map("fraud_investigations")
}

model Notification {
  id        String               @id @default(uuid())
  userId    String?              @map("user_id")
  type      NotificationTypeEnum
  title     String
  message   String
  severity  String               @default("INFO")
  isRead    Boolean              @default(false) @map("is_read")
  metadata  Json?
  createdAt DateTime             @default(now()) @map("created_at")

  @@index([userId])
  @@index([isRead])
  @@index([createdAt])
  @@map("notifications")
}

model AuditLog {
  id          String   @id @default(uuid())
  userId      String?  @map("user_id")
  userEmail   String?  @map("user_email")
  action      String
  entityType  String   @map("entity_type")
  entityId    String   @map("entity_id")
  ipAddress   String   @map("ip_address")
  userAgent   String   @map("user_agent")
  result      String   @default("SUCCESS")
  beforeState Json?    @map("before_state")
  afterState  Json?    @map("after_state")
  createdAt   DateTime @default(now()) @map("created_at")

  user        User?    @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([action])
  @@index([entityType, entityId])
  @@index([createdAt])
  @@map("audit_logs")
}

model OutboxEvent {
  id            String    @id @default(uuid())
  aggregateType String    @map("aggregate_type")
  aggregateId   String    @map("aggregate_id")
  eventType     String    @map("event_type")
  payload       Json
  status        String    @default("PENDING") // PENDING, PUBLISHED, FAILED
  retryCount    Int       @default(0) @map("retry_count")
  createdAt     DateTime  @default(now()) @map("created_at")
  processedAt   DateTime? @map("processed_at")

  @@index([status])
  @@index([createdAt])
  @@map("outbox_events")
}

model IdempotencyRecord {
  id             String    @id @default(uuid())
  idempotencyKey String    @unique @map("idempotency_key")
  resourcePath   String    @map("resource_path")
  statusCode     Int       @map("status_code")
  responseBody   Json      @map("response_body")
  createdAt      DateTime  @default(now()) @map("created_at")
  expiresAt      DateTime  @map("expires_at")

  @@index([idempotencyKey])
  @@map("idempotency_records")
}
