# ==============================================================================
# FinPay360 — Environment Variables Template
# ==============================================================================

# Application Environment
NODE_ENV=development
PORT=3000
API_PREFIX=/api/v1
CORS_ORIGIN=http://localhost:4200

# Database (PostgreSQL)
DATABASE_URL=postgresql://pgadmin:root@localhost:5432/finpay360?schema=public
DB_HOST=localhost
DB_PORT=5432
DB_USER=pgadmin
DB_PASSWORD=root
DB_NAME=finpay360

# Distributed Caching & Locks (Redis)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_TTL_METRICS=300

# Event Streaming (Apache Kafka)
KAFKA_BROKERS=localhost:9092
KAFKA_CLIENT_ID=finpay360-api
KAFKA_GROUP_ID=finpay360-group

# Authentication (OAuth2 / OIDC & JWT)
JWT_SECRET=super-secret-fintech-jwt-key-for-local-dev-only-min-32-chars-long
JWT_EXPIRES_IN=900s
JWT_REFRESH_SECRET=super-secret-refresh-key-for-local-dev-only-min-32-chars-long
JWT_REFRESH_EXPIRES_IN=7d
OIDC_ISSUER=http://localhost:3000/api/v1/auth/mock-idp
OIDC_AUDIENCE=finpay360-client

# Security & Rate Limiting
THROTTLE_TTL=60
THROTTLE_LIMIT=100
IDEMPOTENCY_LOCK_TTL_SECONDS=30
IDEMPOTENCY_CACHE_TTL_SECONDS=86400

# WebSockets
WS_PORT=3000
WS_PATH=/socket.io
